# Neon Postgres
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
# Must match the URL users open in the browser (no trailing slash).
# Local:  http://localhost:3000
# Live:   https://www.databiz.in
BETTER_AUTH_URL=https://www.databiz.in

# App (same origin as BETTER_AUTH_URL in production)
NEXT_PUBLIC_APP_URL=https://www.databiz.in
# Optional comma-separated extras if you use preview hosts
# BETTER_AUTH_TRUSTED_ORIGINS=https://databiz.vercel.app
ALLOWED_EMAIL_DOMAIN=stu.manit.ac.in

# Resend (magic links + transactional mail)
# onboarding@resend.dev can only send to your Resend account email until a domain is verified.
RESEND_API_KEY=
EMAIL_FROM=DataBiz <onboarding@resend.dev>
EMAIL_DEV_FALLBACK=1
CONTACT_INBOX=databiz.nitb@gmail.com

# Cloudinary (signed browser uploads; public_id stored in Neon)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Event day-before reminders are sent from /admin/newsletter (manual — no cron).
